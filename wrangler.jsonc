{
  "name": "mobius-ai",
  "main": "worker 2.js",
  "compatibility_date": "2026-06-01",
  // keep the variables set in the Cloudflare dashboard when deploying from here
  "keep_vars": true,
  // Cloudflare's rate limiter (needs Wrangler 4.36 or later): at most 10 questions a minute
  // from one visitor, counted in each Cloudflare location. Without it the Worker keeps a
  // smaller count of its own.
  "ratelimits": [
    { "name": "RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    // star ratings: at most 20 a minute from one visitor
    { "name": "VOTE_LIMITER", "namespace_id": "1002", "simple": { "limit": 20, "period": 60 } }
  ],
  // the star ratings' small database: a Durable Object with its own SQLite store
  // (free plan), created on the first deploy; no setup in the dashboard is needed
  "durable_objects": {
    "bindings": [{ "name": "RATINGS", "class_name": "Ratings" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Ratings"] }]
}
